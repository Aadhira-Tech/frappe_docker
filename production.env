# Production Environment Configuration for Frappe Docker
# Copy this file to .env and modify the values according to your requirements

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# ERPNext Version - Use stable version tags for production
ERPNEXT_VERSION=v15.77.0

# Database Configuration
DB_PASSWORD=YourSecurePasswordHere123!
DB_NAME=frappe
DB_USER=frappe

# Domain and SSL Configuration
DOMAIN=yourdomain.com
SITES=`yourdomain.com`
LETSENCRYPT_EMAIL=admin@yourdomain.com

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Custom Image Configuration (if using custom apps)
CUSTOM_IMAGE=frappe/erpnext
CUSTOM_TAG=${ERPNEXT_VERSION}
PULL_POLICY=always
RESTART_POLICY=unless-stopped

# Port Configuration
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# Frappe Site Configuration
# Default value is `$$host` which resolves site by host header
# Set to your site name if you want to override this behavior
FRAPPE_SITE_NAME_HEADER=

# Nginx Configuration
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Logging Configuration
TRAEFIK_LOG_LEVEL=INFO

# =============================================================================
# EXTERNAL SERVICES (Optional - only if using external DB/Redis)
# =============================================================================

# External Database (leave empty to use containerized MariaDB)
DB_HOST=
DB_PORT=

# External Redis (leave empty to use containerized Redis)
REDIS_CACHE=
REDIS_QUEUE=

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Database Secrets File (for Docker secrets)
DB_PASSWORD_SECRETS_FILE=

# Development/Testing Override
# FRAPPE_VERSION=develop
# CUSTOM_TAG=develop